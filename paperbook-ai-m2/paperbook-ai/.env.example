# 复制为 .env 后按需修改：copy .env.example .env
# 默认全部走 stub（不联网、不加载模型、不需要任何密钥），可直接跑通 MOCK 流程。
# 真实后端只在本地联调 / 演示时打开，不要把填好的 .env 提交进仓库。

# ---- 后端选择（stub | paddle / stub | http）----
VISION_OCR_BACKEND=stub
VISION_VLM_BACKEND=stub

# ---- PaddleOCR（本机 CPU）----
# PADDLE_PDX_CACHE_HOME=./models/.paddlex
# VISION_OCR_LANG=ch
# VISION_OCR_USE_MKLDNN=0

# ---- VLM（OpenAI 兼容端点，如本机 Ollama）----
# QWEN_VL_BASE_URL=http://127.0.0.1:11434/v1
# QWEN_VL_MODEL=qwen2.5vl:3b
# QWEN_VL_MAX_TOKENS=4000
# QWEN_VL_TIMEOUT=180

# ---- 数据目录（默认仓库内 data/）----
# DATA_DIR=./data
