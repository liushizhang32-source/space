# 复制为 .env 后按需修改：copy .env.example .env
# 默认全部走 stub（不联网、不加载模型、不需要任何密钥），可直接跑通 MOCK 流程。
# 真实后端只在本地联调 / 演示时打开，不要把填好的 .env 提交进仓库。

# ---- 后端选择（OCR: stub | paddle，VLM: stub | http）----
VISION_OCR_BACKEND=stub
VISION_VLM_BACKEND=stub

# ---- 产物根目录 ----
DATA_DIR=./data

# ---- PaddleOCR（真实 OCR 时取消注释）----
# PADDLE_PDX_CACHE_HOME=./models/.paddlex
# PADDLE_OCR_LANG=ch
# PADDLE_OCR_MKLDNN=0
# PADDLE_OCR_ORIENTATION=0
# PADDLE_OCR_MODEL_DIR=./models/paddleocr

# ---- OpenAI 兼容 VLM 服务（真实 VLM 时取消注释并填写）----
# 本地 Ollama 示例：ollama serve 后拉取 qwen2.5vl:3b
# QWEN_VL_BASE_URL=http://127.0.0.1:11434/v1
# QWEN_VL_API_KEY=
# QWEN_VL_MODEL=qwen2.5vl:3b
# QWEN_VL_MAX_TOKENS=4000
# QWEN_VL_TIMEOUT=180

# ---- 讲解 / 索引 ----
# QWEN_VL_EXPLAIN_TOKENS=6000
