{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://paperbook-ai/contracts/ocr.schema.json",
  "title": "ocr.json（C1，成员2 → 成员3）",
  "description": "docs/API_v1.0.md §1.12 C1。冻结规则：只许新增可选字段，禁止 additionalProperties:false。",
  "type": "object",
  "required": [
    "schema_version",
    "book_id",
    "page_id",
    "page_no",
    "status",
    "image_width",
    "image_height",
    "text_blocks",
    "page_confidence",
    "elapsed_ms"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "book_id": { "type": "string", "pattern": "^[a-z][a-z0-9]{3,11}$" },
    "page_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{3,11}_p\\d{2}$"
    },
    "page_no": { "type": "integer", "minimum": 1, "maximum": 99 },
    "status": { "enum": ["ok", "empty", "failed"] },
    "image_width": { "type": "integer", "minimum": 1 },
    "image_height": { "type": "integer", "minimum": 1 },
    "text_blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block_id", "order", "text", "bbox", "confidence"],
        "properties": {
          "block_id": { "type": "string", "pattern": "^.+_t\\d{2}$" },
          "order": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "integer", "minimum": 0 }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "page_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "error": {
      "type": "object",
      "description": "可选扩展：status=failed 时给出错误码与原因（新增可选字段，不改契约）",
      "properties": {
        "code": { "type": "integer" },
        "msg": { "type": "string" }
      }
    },
    "producer": {
      "type": "object",
      "description": "可选扩展：产出方与后端名，用于复现与排障（新增可选字段）",
      "properties": {
        "module": { "type": "string" },
        "backend": { "type": "string" },
        "version": { "type": "string" }
      }
    }
  }
}
