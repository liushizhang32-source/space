{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://paperbook-ai/contracts/vlm.schema.json",
  "title": "vlm.json（C2，成员2 → 成员3）",
  "description": "docs/API_v1.0.md §1.12 C2。冻结规则：只许新增可选字段，禁止 additionalProperties:false。",
  "type": "object",
  "required": [
    "schema_version",
    "book_id",
    "page_id",
    "page_no",
    "status",
    "image_width",
    "image_height",
    "description",
    "objects",
    "scene_tags",
    "safety",
    "elapsed_ms"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "book_id": { "type": "string", "pattern": "^[a-z][a-z0-9]{3,11}$" },
    "page_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{3,11}_p\\d{2}$"
    },
    "page_no": { "type": "integer", "minimum": 1, "maximum": 99 },
    "status": {
      "enum": ["ok", "empty"],
      "description": "公共 VLMData 只有 ok/empty；阶段失败不产出本文件，走 data/logs/*.error.json"
    },
    "image_width": { "type": "integer", "minimum": 1 },
    "image_height": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object_id", "label", "bbox", "confidence"],
        "properties": {
          "object_id": { "type": "string", "pattern": "^.+_o\\d{2}$" },
          "label": { "type": "string", "minLength": 1 },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "integer", "minimum": 0 }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "scene_tags": { "type": "array", "items": { "type": "string" } },
    "safety": {
      "type": "object",
      "required": ["pass", "flags"],
      "properties": {
        "pass": { "type": "boolean" },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "error": {
      "type": "object",
      "description": "可选扩展：status=failed 时给出错误码与原因（新增可选字段）",
      "properties": {
        "code": { "type": "integer" },
        "msg": { "type": "string" }
      }
    },
    "producer": {
      "type": "object",
      "description": "可选扩展：产出方与后端名，用于复现与排障（新增可选字段）",
      "properties": {
        "module": { "type": "string" },
        "backend": { "type": "string" },
        "version": { "type": "string" }
      }
    }
  }
}
