{
  "$defs": {
    "ModelInfo": {
      "additionalProperties": true,
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "StorySegment": {
      "additionalProperties": true,
      "properties": {
        "segment_id": {
          "pattern": "^.+_s\\d{2}$",
          "title": "Segment Id",
          "type": "string"
        },
        "order": {
          "maximum": 99,
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "narration": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Narration",
          "type": "string"
        },
        "scene": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Scene",
          "type": "string"
        },
        "image_prompt": {
          "anyOf": [
            {
              "maxLength": 600,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Prompt"
        },
        "duration_sec": {
          "exclusiveMinimum": 0,
          "title": "Duration Sec",
          "type": "number"
        },
        "duration_source": {
          "enum": [
            "tts",
            "estimate"
          ],
          "title": "Duration Source",
          "type": "string"
        },
        "audio_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Url"
        },
        "highlight_object_ids": {
          "items": {
            "type": "string"
          },
          "title": "Highlight Object Ids",
          "type": "array"
        }
      },
      "required": [
        "segment_id",
        "order",
        "narration",
        "scene",
        "duration_sec",
        "duration_source"
      ],
      "title": "StorySegment",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "book_id": {
      "title": "Book Id",
      "type": "string"
    },
    "page_id": {
      "title": "Page Id",
      "type": "string"
    },
    "page_no": {
      "maximum": 99,
      "minimum": 1,
      "title": "Page No",
      "type": "integer"
    },
    "title": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "age_level": {
      "enum": [
        "3-6",
        "6-9"
      ],
      "title": "Age Level",
      "type": "string"
    },
    "status": {
      "const": "ok",
      "title": "Status",
      "type": "string"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/StorySegment"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    },
    "total_duration_sec": {
      "exclusiveMinimum": 0,
      "title": "Total Duration Sec",
      "type": "number"
    },
    "safety_pass": {
      "title": "Safety Pass",
      "type": "boolean"
    },
    "safety_flags": {
      "items": {
        "type": "string"
      },
      "title": "Safety Flags",
      "type": "array"
    },
    "model": {
      "$ref": "#/$defs/ModelInfo"
    },
    "elapsed_ms": {
      "minimum": 0,
      "title": "Elapsed Ms",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "book_id",
    "page_id",
    "page_no",
    "title",
    "age_level",
    "status",
    "segments",
    "total_duration_sec",
    "safety_pass",
    "model",
    "elapsed_ms"
  ],
  "title": "StoryDoc",
  "type": "object"
}
