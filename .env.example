# ===== 视觉（成员 2）=====
PADDLE_OCR_MODEL_DIR=./models/paddleocr
QWEN_VL_MODEL_PATH=./models/qwen2-vl
QWEN_VL_API_KEY=

# ===== 生成（成员 3）=====
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
TTS_ENGINE=
TTS_VOICE_ID=female_warm
FFMPEG_PATH=ffmpeg

# ===== 语音（成员 4）=====
WHISPER_MODEL_PATH=./models/whisper-large-v3

# ===== 存储 =====
DATA_DIR=./data
ASSET_BASE_URL=http://127.0.0.1:8000

# ===== 运行（成员 1）=====
MAX_RETRY=1
STAGE_TIMEOUT_SEC=30
MAX_CONCURRENT_JOBS=3

# =====================================================================
# 以下为成员 3 模块新增的可选项（API v1.0 §1.16 只规定了上面那些；
# 这里全部有默认值，不配也能跑，属于“实现细节配置”，不是接口字段）
# =====================================================================

# TTS 引擎：auto = 配了 TTS_HTTP_URL 走 http，否则用 silent（静音 mock）
#   silent  本地 mock，生成等长静音 mp3，必须明确不是真实语音
#   http    调用真实 TTS 服务：POST TTS_HTTP_URL，JSON {text,voice_id,speed,format}
TTS_ENGINE=auto
TTS_HTTP_URL=
TTS_API_KEY=
TTS_SPEED=1.0
TTS_SAMPLE_RATE=24000
TTS_TIMEOUT_SEC=20

# 视频：分辨率取 Q4 建议值 720x1280（1080x1920 只需改这里，不改代码）
FFPROBE_PATH=ffprobe
VIDEO_RESOLUTION=720x1280
VIDEO_FPS=25
VIDEO_TIMEOUT_SEC=180
# 字幕字体，留空则自动找系统字体（Windows: msyh.ttc / simhei.ttf）
VIDEO_FONT=

# 故事：LLM 没配时走 mock 模板；配了但调用失败时默认按契约判 failed
STORY_TIMEOUT_SEC=60
STORY_FALLBACK_ON_ERROR=0

# 安全过滤：v1 默认关闭，字段与分支已实现（Q8）
SAFETY_ENABLED=0
SAFETY_BLOCKLIST=
